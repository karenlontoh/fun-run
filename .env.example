# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# Public URL this app is deployed at. Used to build the QR code's target link
# (https://<this>/verify/<id>). Update after you deploy to Vercel or attach
# a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (resend.com) — sends the registration confirmation PDF and the
# committee notification email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be "onboarding@resend.dev" until you verify your own domain in Resend
# (onboarding@resend.dev only delivers to the Resend account's own email).
EMAIL_FROM=Paulus Fun Run <onboarding@resend.dev>

# Shared passcode race-day committee members enter once (per device) to view
# /verify pages. Pick anything — e.g. a 6-digit PIN. Keep it out of any
# public materials; only share it with committee members directly.
VERIFY_ACCESS_CODE=change-me-123456

# Google AI Studio (aistudio.google.com/apikey) — used by the Race Photos
# admin page to automatically detect BIB numbers in uploaded photos.
GEMINI_API_KEY=AIzaSy...
# Optional: override the model used for BIB detection. Defaults to
# gemini-3.8-flash if unset.
# GEMINI_MODEL=gemini-3.8-flash
